{
  "name": "@local/dsh-usage-dashboard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Daily token usage with a per-model breakdown for the DeepSeek Harness",
  "scripts": {
    "test": "node test/fold-test.mjs && node test/features-test.mjs && node test/balance-test.mjs && node test/review-check.cjs && node test/client-smoke.cjs",
    "check": "node --check index.js && node --check client.js"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs",
    "test/*.mjs",
    "test/*.cjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fairyqinglan/dsh-usage-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/fairyqinglan/dsh-usage-dashboard/issues"
  },
  "homepage": "https://github.com/fairyqinglan/dsh-usage-dashboard#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis-plugin",
    "token-usage",
    "usage-dashboard"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
